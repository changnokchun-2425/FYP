{# ========================================
   EDIT PROFILE PAGE
   ========================================
   Purpose: Allow users to update their account information
   Features:
   - Update username, email, phone
   - Change password
   - Avatar upload (placeholder)
   - Delete account option
   - Form validation
======================================== #}

<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>修改個人資料 - FYP Cinema</title>
    <style>
        /* ========== GLOBAL RESET ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Microsoft JhengHei', 'PingFang TC', sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
            min-height: 100vh;
            padding: 20px;
            color: #fff;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        .header h1 {
            color: #fff;
            font-size: 28px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .back-btn {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s;
            font-size: 16px;
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .profile-card {
            background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            border: 1px solid #333;
        }

        .avatar-section {
            background: linear-gradient(135deg, #e50914, #b20710);
            padding: 40px 20px;
            text-align: center;
            position: relative;
        }

        .avatar-container {
            position: relative;
            display: inline-block;
        }

        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            margin: 0 auto 15px;
            border: 5px solid rgba(255, 255, 255, 0.3);
        }

        .change-avatar-btn {
            position: absolute;
            bottom: 5px;
            right: 5px;
            background: #fff;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            transition: all 0.3s;
        }

        .change-avatar-btn:hover {
            transform: scale(1.1);
        }

        .username-display {
            color: #fff;
            font-size: 24px;
            font-weight: bold;
        }

        .form-section {
            padding: 40px;
        }

        .section-title {
            font-size: 20px;
            font-weight: bold;
            color: #e50914;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #333;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            font-weight: bold;
            color: #fff;
            margin-bottom: 8px;
        }

        .required {
            color: #e50914;
        }

        .form-input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #444;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s;
            font-family: inherit;
            background-color: #1a1a1a;
            color: white;
        }

        .form-input:focus {
            outline: none;
            border-color: #e50914;
            box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.2);
        }

        .form-input:disabled {
            background: #f5f5f5;
            cursor: not-allowed;
        }

        .input-hint {
            font-size: 12px;
            color: #888;
            margin-top: 5px;
        }

        .password-toggle {
            position: relative;
        }

        .toggle-password-btn {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            font-size: 20px;
            color: #666;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            padding-top: 30px;
            border-top: 2px solid #333;
        }

        .submit-btn {
            flex: 1;
            padding: 15px;
            background: linear-gradient(135deg, #e50914 0%, #c40812 100%);
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: all 0.3s;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(229, 9, 20, 0.4);
        }

        .cancel-btn {
            flex: 1;
            padding: 15px;
            background: #2a2a2a;
            color: #fff;
            border: 2px solid #444;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: all 0.3s;
            text-decoration: none;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cancel-btn:hover {
            border-color: #e50914;
            background: #333;
        }

        .danger-zone {
            margin-top: 30px;
            padding: 20px;
            background: #fff5f5;
            border: 2px solid #fee;
            border-radius: 8px;
        }

        .danger-title {
            color: #e50914;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .delete-account-btn {
            padding: 10px 20px;
            background: #fff;
            color: #e50914;
            border: 2px solid #e50914;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
        }

        .delete-account-btn:hover {
            background: #e50914;
            color: #fff;
        }

        .flash-messages {
            margin-bottom: 20px;
        }

        .flash-message {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .flash-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .flash-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .flash-info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 22px;
            }

            .form-section {
                padding: 25px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚙️ 修改個人資料</h1>
            <a href="{{ url_for('profile') }}" class="back-btn">← 返回個人中心</a>
        </div>

        <div class="profile-card">
            <div class="avatar-section">
                <div class="avatar-container">
                    <div class="avatar">👤</div>
                    <button class="change-avatar-btn" onclick="alert('更換頭像功能開發中...')">📷</button>
                </div>
                <div class="username-display">{{ current_user.username }}</div>
            </div>

            <div class="form-section">
                <!-- Flash Messages -->
                {% with messages = get_flashed_messages(with_categories=true) %}
                    {% if messages %}
                        <div class="flash-messages">
                            {% for category, message in messages %}
                                <div class="flash-message flash-{{ category }}">
                                    {% if category == 'success' %}
                                        ✅
                                    {% elif category == 'error' %}
                                        ❌
                                    {% else %}
                                        ℹ️
                                    {% endif %}
                                    {{ message }}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endwith %}

                <form method="POST" action="{{ url_for('edit_profile') }}">
                    <!-- ========== BASIC INFORMATION SECTION ========== -->
                    <div class="section-title">
                        👤 基本資料
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            用戶名稱 <span class="required">*</span>
                        </label>
                        <input 
                            type="text" 
                            name="username" 
                            class="form-input" 
                            value="{{ current_user.username }}"
                            required
                        >
                        <div class="input-hint">這是您的顯示名稱</div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                電子郵件 <span class="required">*</span>
                            </label>
                            <input 
                                type="email" 
                                name="email" 
                                class="form-input" 
                                value="{{ current_user.email if current_user.email else '' }}"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                手機號碼
                            </label>
                            <input 
                                type="tel" 
                                name="phone" 
                                class="form-input" 
                                value="{{ current_user.phone if current_user.phone else '' }}"
                                placeholder="+852 1234 5678"
                            >
                        </div>
                    </div>

                    <!-- ========== PASSWORD CHANGE SECTION ========== -->
                    <div class="section-title" style="margin-top: 40px;">
                        🔒 更改密碼
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            目前密碼
                        </label>
                        <div class="password-toggle">
                            <input 
                                type="password" 
                                name="current_password" 
                                class="form-input" 
                                id="current_password"
                                placeholder="若不更改密碼請留空"
                            >
                            <button type="button" class="toggle-password-btn" onclick="togglePassword('current_password')">👁️</button>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                新密碼
                            </label>
                            <div class="password-toggle">
                                <input 
                                    type="password" 
                                    name="new_password" 
                                    class="form-input" 
                                    id="new_password"
                                    placeholder="若不更改密碼請留空"
                                >
                                <button type="button" class="toggle-password-btn" onclick="togglePassword('new_password')">👁️</button>
                            </div>
                            <div class="input-hint">至少 8 個字元</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                確認新密碼
                            </label>
                            <div class="password-toggle">
                                <input 
                                    type="password" 
                                    name="confirm_password" 
                                    class="form-input" 
                                    id="confirm_password"
                                    placeholder="再次輸入新密碼"
                                >
                                <button type="button" class="toggle-password-btn" onclick="togglePassword('confirm_password')">👁️</button>
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <a href="{{ url_for('profile') }}" class="cancel-btn">取消</a>
                        <button type="submit" class="submit-btn">儲存變更</button>
                    </div>
                </form>

                <div class="danger-zone">
                    <div class="danger-title">⚠️ 危險操作</div>
                    <p style="font-size: 14px; color: #666; margin-bottom: 10px;">
                        刪除帳戶後，所有資料將永久清除且無法復原。
                    </p>
                    <button class="delete-account-btn" onclick="confirmDelete()">
                        刪除帳戶
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================
         JAVASCRIPT - Form Validation & Password Toggle
    ======================================== -->
    <script>
        /* ========== PASSWORD VISIBILITY TOGGLE ========== */
        // Show/hide password fields
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const button = input.nextElementSibling;
            
            if (input.type === 'password') {
                input.type = 'text';
                button.textContent = '🙈';
            } else {
                input.type = 'password';
                button.textContent = '👁️';
            }
        }

        // 確認刪除帳戶
        function confirmDelete() {
            if (confirm('⚠️ 您確定要刪除帳戶嗎？此操作無法復原！')) {
                if (confirm('請再次確認：這將永久刪除您的所有資料！')) {
                    alert('刪除帳戶功能開發中...');
                }
            }
        }

        // 表單驗證
        document.querySelector('form').addEventListener('submit', function(e) {
            const newPassword = document.getElementById('new_password').value;
            const confirmPassword = document.getElementById('confirm_password').value;
            
            if (newPassword || confirmPassword) {
                if (newPassword !== confirmPassword) {
                    e.preventDefault();
                    alert('❌ 新密碼與確認密碼不符！');
                    return false;
                }
                
                if (newPassword.length < 8) {
                    e.preventDefault();
                    alert('❌ 新密碼必須至少 8 個字元！');
                    return false;
                }
            }
        });
    </script>
</body>
</html>
