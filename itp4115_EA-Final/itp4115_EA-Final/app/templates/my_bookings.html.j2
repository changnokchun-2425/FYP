<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的訂票記錄 - MCL Cinema</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Microsoft JhengHei', 'PingFang TC', sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .header h1 {
            color: #fff;
            font-size: 28px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .back-btn {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s;
            font-size: 16px;
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            background: rgba(255, 255, 255, 0.95);
            padding: 10px;
            border-radius: 15px;
        }

        .tab-btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            background: transparent;
            color: #1e3c72;
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: all 0.3s;
        }

        .tab-btn:hover {
            background: rgba(30, 60, 114, 0.1);
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
        }

        .bookings-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .booking-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s;
            position: relative;
            overflow: hidden;
        }

        .booking-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient(135deg, #e50914 0%, #c40812 100%);
        }

        .booking-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .booking-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 2px dashed #e0e0e0;
        }

        .booking-title {
            font-size: 22px;
            font-weight: bold;
            color: #1e3c72;
            margin-bottom: 5px;
        }

        .booking-id {
            font-size: 12px;
            color: #888;
        }

        .booking-status {
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-confirmed {
            background: #d4edda;
            color: #155724;
        }

        .status-upcoming {
            background: #fff3cd;
            color: #856404;
        }

        .status-completed {
            background: #d1ecf1;
            color: #0c5460;
        }

        .booking-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .detail-icon {
            font-size: 20px;
        }

        .detail-content {
            flex: 1;
        }

        .detail-label {
            font-size: 12px;
            color: #888;
            margin-bottom: 2px;
        }

        .detail-value {
            font-size: 15px;
            color: #333;
            font-weight: bold;
        }

        .booking-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 2px dashed #e0e0e0;
        }

        .total-price {
            font-size: 24px;
            font-weight: bold;
            color: #e50914;
        }

        .action-btns {
            display: flex;
            gap: 10px;
        }

        .action-btn {
            padding: 8px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: all 0.3s;
        }

        .view-ticket-btn {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
        }

        .view-ticket-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(30, 60, 114, 0.4);
        }

        .cancel-btn {
            background: #fff;
            color: #e50914;
            border: 2px solid #e50914;
        }

        .cancel-btn:hover {
            background: #e50914;
            color: #fff;
        }

        .empty-state {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 60px 20px;
            text-align: center;
        }

        .empty-icon {
            font-size: 80px;
            margin-bottom: 20px;
        }

        .empty-text {
            font-size: 18px;
            color: #666;
            margin-bottom: 10px;
        }

        .empty-subtext {
            font-size: 14px;
            color: #999;
            margin-bottom: 25px;
        }

        .browse-btn {
            display: inline-block;
            padding: 12px 30px;
            background: linear-gradient(135deg, #e50914 0%, #c40812 100%);
            color: #fff;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
            transition: all 0.3s;
        }

        .browse-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(229, 9, 20, 0.4);
        }

        .flash-messages {
            margin-bottom: 20px;
        }

        .flash-message {
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .flash-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .flash-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .status-cancelled {
            background: #f8d7da;
            color: #721c24;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 22px;
            }

            .booking-header {
                flex-direction: column;
                gap: 10px;
            }

            .booking-details {
                grid-template-columns: 1fr;
            }

            .booking-footer {
                flex-direction: column;
                gap: 15px;
                align-items: stretch;
            }

            .action-btns {
                width: 100%;
            }

            .action-btn {
                flex: 1;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎫 我的訂票記錄</h1>
            <a href="{{ url_for('profile') }}" class="back-btn">← 返回個人中心</a>
        </div>

        <!-- Flash Messages -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="flash-messages">
                    {% for category, message in messages %}
                        <div class="flash-message flash-{{ category }}">
                            {% if category == 'success' %}
                                ✅
                            {% elif category == 'error' %}
                                ❌
                            {% else %}
                                ℹ️
                            {% endif %}
                            {{ message }}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        <div class="tabs">
            <button class="tab-btn active">全部訂單</button>
            <button class="tab-btn">即將觀看</button>
            <button class="tab-btn">已完成</button>
        </div>

        {% if bookings and bookings|length > 0 %}
        <div class="bookings-list">
            {% for booking in bookings %}
            <div class="booking-card">
                <div class="booking-header">
                    <div>
                        <div class="booking-title">{{ booking.movie_title }}</div>
                        <div class="booking-id">訂單編號: #{{ booking.id }}</div>
                    </div>
                    {% if booking.status == 'cancelled' %}
                        <span class="booking-status status-cancelled">已取消</span>
                    {% elif booking.status == 'completed' %}
                        <span class="booking-status status-completed">已完成</span>
                    {% else %}
                        <span class="booking-status status-confirmed">已確認</span>
                    {% endif %}
                </div>

                <div class="booking-details">
                    <div class="detail-item">
                        <span class="detail-icon">🎬</span>
                        <div class="detail-content">
                            <div class="detail-label">電影名稱</div>
                            <div class="detail-value">{{ booking.movie_title }}</div>
                        </div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-icon">📅</span>
                        <div class="detail-content">
                            <div class="detail-label">場次時間</div>
                            <div class="detail-value">{{ booking.showtime }}</div>
                        </div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-icon">🪑</span>
                        <div class="detail-content">
                            <div class="detail-label">座位數量</div>
                            <div class="detail-value">{{ booking.seats }} 個座位</div>
                        </div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-icon">👤</span>
                        <div class="detail-content">
                            <div class="detail-label">訂票人</div>
                            <div class="detail-value">{{ booking.name }}</div>
                        </div>
                    </div>
                </div>

                <div class="booking-footer">
                    <div class="total-price">HK$ {{ booking.total_price }}</div>
                    <div class="action-btns">
                        <button class="action-btn view-ticket-btn" onclick="alert('電子票券功能開發中...')">查看票券</button>
                        {% if booking.status != 'cancelled' %}
                        <form method="POST" action="{{ url_for('cancel_ticket', ticket_id=booking.id) }}" style="display: inline;" onsubmit="return confirm('確定要取消此訂單嗎？退款將在 3-5 個工作天內處理。')">
                            <button type="submit" class="action-btn cancel-btn">退票</button>
                        </form>
                        {% else %}
                        <button class="action-btn cancel-btn" disabled style="opacity: 0.5; cursor: not-allowed;">已取消</button>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-icon">🎬</div>
            <div class="empty-text">暫無訂票記錄</div>
            <div class="empty-subtext">快去選購您喜歡的電影吧！</div>
            <a href="{{ url_for('cinema_index') }}" class="browse-btn">瀏覽電影</a>
        </div>
        {% endif %}
    </div>

    <script>
        // 標籤切換功能
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
            });
        });
    </script>
</body>
</html>
