{% extends "base.html.j2" %}
{% block title %}註冊 - FYP Cinema{% endblock %}
{% block content %}
<style>
    .auth-shell { max-width: 480px; margin: 32px auto; padding: 24px; border-radius: 16px; background: var(--panel); border: 1px solid var(--border); box-shadow: var(--shadow); }
    .auth-shell h2 { margin: 0 0 8px 0; }
    .auth-shell p { margin: 0 0 14px 0; color: var(--muted); }
    label { display: block; margin: 12px 0 6px 0; font-weight: 700; }
    input[type="text"], input[type="email"], input[type="password"] { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--panel-2); color: var(--text); }
    .auth-footer { margin-top: 14px; text-align: center; color: var(--muted); }
</style>
<div class="auth-shell">
    <h2>會員註冊</h2>
    <p>加入 FYP Cinema，享受最新電影資訊與優惠。</p>
    <form action="" method="post" novalidate>
        {{ form.hidden_tag() }}
        <label for="username">用戶名</label>
        {{ form.username(size=32, placeholder="輸入用戶名") }}
        {% for error in form.username.errors %}<div style="color: var(--danger); font-size: 0.9rem;">{{ error }}</div>{% endfor %}

        <label for="email">電郵</label>
        {{ form.email(size=64, placeholder="your@email.com") }}
        {% for error in form.email.errors %}<div style="color: var(--danger); font-size: 0.9rem;">{{ error }}</div>{% endfor %}

        <label for="password">密碼</label>
        {{ form.password(size=32, placeholder="設定密碼") }}
        {% for error in form.password.errors %}<div style="color: var(--danger); font-size: 0.9rem;">{{ error }}</div>{% endfor %}

        <label for="password2">確認密碼</label>
        {{ form.password2(size=32, placeholder="再次輸入密碼") }}
        {% for error in form.password2.errors %}<div style="color: var(--danger); font-size: 0.9rem;">{{ error }}</div>{% endfor %}

        <button type="submit" class="btn btn-primary" style="width:100%; margin-top:12px;">建立帳號</button>
    </form>
    <div class="auth-footer">
        已有帳號？ <a href="{{ url_for('login') }}">登入</a>
    </div>
</div>
{% endblock %}
