{% extends "base.html.j2" %}
{% block title %}即將上映 - FYP Cinema{% endblock %}
{% block content %}
<style>
    .soon-hero {
        margin-top: 18px;
        padding: 24px;
        border-radius: 18px;
        border: 1px solid var(--border);
        background: radial-gradient(circle at 20% 20%, rgba(246,208,0,0.18), transparent 35%), var(--panel);
    }
    .soon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
    .soon-card { position: relative; overflow: hidden; }
    .badge-release { position: absolute; top: 10px; left: 10px; padding: 6px 10px; border-radius: 999px; background: var(--primary); color: #0b0b0b; font-weight: 800; font-size: 0.85rem; }
    .soon-title { margin: 10px 0 6px 0; font-size: 1rem; }
    .soon-meta { color: var(--muted); font-size: 0.85rem; display: flex; gap: 8px; flex-wrap: wrap; }
    .soon-desc { color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin: 8px 0; }
    .btn-notify { width: 100%; text-align: center; }
</style>

<section class="soon-hero">
    <h1 style="margin:0 0 6px 0;">📅 即將上映</h1>
    <p style="margin:0; color: var(--muted);">提前鎖定想看的電影，演出前收到通知。</p>
</section>

<section class="section">
    <div class="section-header">
        <h2>不日上映</h2>
        <span class="pill">{{ movies|length }} 套即將上映</span>
    </div>
    <div class="soon-grid">
        {% for movie in movies %}
        <article class="card soon-card">
            <span class="badge-release">{{ movie.release_date }} 上映</span>
            <img class="movie-poster" src="{{ movie.poster }}" alt="{{ movie.title }}" onerror="this.src='https://via.placeholder.com/300x450?text=FYP+Cinema'">
            <div class="movie-body">
                <h3 class="soon-title">{{ movie.title }}</h3>
                <div class="soon-meta">
                    {% if movie.genre %}<span class="badge">{{ movie.genre }}</span>{% endif %}
                    {% if movie.rating %}<span class="badge">{{ movie.rating }}</span>{% endif %}
                </div>
                <p class="soon-desc">{{ movie.description or '片方資訊即將公布。' }}</p>
                <a class="btn btn-primary btn-notify" href="{{ url_for('cinema_movie', movie_id=movie.id) }}">🔔 關注影片</a>
            </div>
        </article>
        {% else %}
            <div class="card" style="padding:16px;">暫無影片</div>
        {% endfor %}
    </div>
</section>
{% endblock %}
