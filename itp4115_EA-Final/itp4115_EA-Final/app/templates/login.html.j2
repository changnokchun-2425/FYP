{# ========================================
   LOGIN PAGE
   ========================================
   Purpose: User authentication page
   Features:
   - Username/Password input
   - Remember me checkbox
   - Math captcha verification
   - Flash message display
   - Links to register page
======================================== #}

<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <!-- ========== META TAGS ========== -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>登入 - FYP Cinema</title>
    
    <!-- ========== PAGE STYLES ========== -->
    <style>
        /* ========== GLOBAL RESET ========== */ {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ========== BODY & LAYOUT ========== */
        body {
            font-family: 'Microsoft YaHei', 'Arial', sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        header h1 {
            color: #fff;
            font-size: 2rem;
            text-align: center;
        }

        .login-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        .login-box {
            background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
            border-radius: 20px;
            padding: 3rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            max-width: 450px;
            width: 100%;
            border: 1px solid #333;
        }

        .login-box h2 {
            color: #fff;
            font-size: 2rem;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .login-box p.subtitle {
            color: #aaa;
            text-align: center;
            margin-bottom: 2rem;
        }

        .flash-messages {
            margin-bottom: 1.5rem;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-size: 1rem;
            text-align: center;
        }

        .alert-error {
            background-color: rgba(229, 9, 20, 0.2);
            border: 2px solid #e50914;
            color: #ff6b6b;
        }

        /* ========== FORM ELEMENTS ========== */
        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            color: #fff;
            font-weight: bold;
            margin-bottom: 0.5rem;
            font-size: 1rem;
        }

        .form-group input[type="text"],
        .form-group input[type="password"] {
            width: 100%;
            padding: 1rem;
            border: 2px solid #444;
            border-radius: 8px;
            background-color: #1a1a1a;
            color: white;
            font-size: 1rem;
            transition: border-color 0.3s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #e50914;
        }

        .error {
            color: #e50914;
            font-size: 0.9rem;
            margin-top: 0.3rem;
        }

        .remember-me {
            display: flex;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .remember-me input[type="checkbox"] {
            margin-right: 0.5rem;
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .remember-me label {
            color: #ccc;
            cursor: pointer;
        }

        .captcha-box {
            background-color: #2a2a2a;
            border: 2px solid #444;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .captcha-question {
            color: #fff;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .captcha-input {
            width: 100%;
            padding: 0.8rem;
            border: 2px solid #444;
            border-radius: 8px;
            background-color: #1a1a1a;
            color: white;
            font-size: 1rem;
            text-align: center;
        }

        .captcha-input:focus {
            outline: none;
            border-color: #e50914;
        }

        /* ========== BUTTONS ========== */
        .submit-btn {
            width: 100%;
            padding: 1.2rem;
            background: linear-gradient(135deg, #e50914, #b20710);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 8px rgba(229, 9, 20, 0.3);
        }

        .submit-btn:hover {
            background: linear-gradient(135deg, #ff1a24, #e50914);
            box-shadow: 0 6px 16px rgba(229, 9, 20, 0.5);
            transform: translateY(-2px);
        }

        .register-link {
            text-align: center;
            margin-top: 1.5rem;
            color: #aaa;
        }

        .register-link a {
            color: #e50914;
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s;
        }

        .register-link a:hover {
            color: #ff1a24;
            text-decoration: underline;
        }

        .back-link {
            text-align: center;
            margin-top: 1rem;
        }

        .back-link a {
            color: #2a5298;
            text-decoration: none;
            transition: color 0.3s;
        }

        .back-link a:hover {
            color: #3a62a8;
        }

        footer {
            background-color: #0a0a0a;
            text-align: center;
            padding: 1.5rem;
            border-top: 2px solid #2a5298;
            color: #888;
        }

        @media (max-width: 768px) {
            .login-box {
                padding: 2rem;
            }

            header h1 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- ========================================
         HEADER SECTION
    ======================================== -->
    <header>
        <h1>🎬 FYP Cinema</h1>
    </header>

    <!-- ========================================
         LOGIN FORM CONTAINER
    ======================================== -->
    <div class="login-container">
        <div class="login-box">
            <h2>會員登入</h2>
            <p class="subtitle">登入以享受更多優惠和服務</p>

            <!-- Flash Messages Display -->
            {% with messages = get_flashed_messages() %}
                {% if messages %}
                    <div class="flash-messages">
                        {% for message in messages %}
                            <div class="alert alert-error">{{ message }}</div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endwith %}

            <!-- Login Form -->
            <form action="" method="post" novalidate>
                {{ form.hidden_tag() }}
                
                <!-- Username Field -->
                <div class="form-group">
                    {{ form.username.label }}
                    {{ form.username(size=32) }}
                    {% for error in form.username.errors %}
                    <span class="error">[{{ error }}]</span>
                    {% endfor %}
                </div>

                <div class="form-group">
                    {{ form.password.label }}
                    {{ form.password(size=32) }}
                    {% for error in form.password.errors %}
                    <span class="error">[{{ error }}]</span>
                    {% endfor %}
                </div>

                <div class="remember-me">
                    {{ form.remember_me() }} {{ form.remember_me.label }}
                </div>

                <div class="captcha-box">
                    <div class="captcha-question" id="captcha-question"></div>
                    <input type="text" id="captcha-input" class="captcha-input" placeholder="請輸入答案" required>
                    <input type="hidden" id="captcha-answer" name="captcha_answer">
                    <span class="error" id="captcha-error"></span>
                </div>

                {{ form.submit(class="submit-btn", onclick="return validateCaptcha()") }}
            </form>

            <div class="register-link">
                還沒有帳號？ <a href="{{ url_for('register') }}">立即註冊</a>
            </div>

            <div class="back-link">
                <a href="{{ url_for('cinema_index') }}">← 返回首頁</a>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2025 FYP Cinema. All rights reserved.</p>
    </footer>

    <!-- ========================================
         JAVASCRIPT - Captcha Validation
    ======================================== -->
    <script>
        /* ========== CAPTCHA GENERATION ========== */
        // Generate random math problem for captcha
        let num1, num2, correctAnswer;

        function generateCaptcha() {
            num1 = Math.floor(Math.random() * 10) + 1;
            num2 = Math.floor(Math.random() * 10) + 1;
            correctAnswer = num1 + num2;
            document.getElementById('captcha-question').textContent = `驗證問題: ${num1} + ${num2} = ?`;
            document.getElementById('captcha-input').value = '';
            document.getElementById('captcha-error').textContent = '';
        }

        function validateCaptcha() {
            const userAnswer = parseInt(document.getElementById('captcha-input').value);
            if (isNaN(userAnswer) || userAnswer !== correctAnswer) {
                document.getElementById('captcha-error').textContent = '驗證答案錯誤，請重試';
                generateCaptcha();
                return false;
            }
            document.getElementById('captcha-answer').value = correctAnswer;
            return true;
        }

        // Generate captcha on page load
        window.onload = function() {
            generateCaptcha();
        };
    </script>
</body>
</html>
