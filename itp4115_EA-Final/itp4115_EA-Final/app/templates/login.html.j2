{% extends "base.html.j2" %}
{% block title %}登入 - FYP Cinema{% endblock %}
{% block content %}
<style>
    .auth-shell { max-width: 420px; margin: 32px auto; padding: 24px; border-radius: 16px; background: var(--panel); border: 1px solid var(--border); box-shadow: var(--shadow); }
    .auth-shell h2 { margin: 0 0 8px 0; }
    .auth-shell p { margin: 0 0 14px 0; color: var(--muted); }
    label { display: block; margin: 12px 0 6px 0; font-weight: 700; }
    input[type="text"], input[type="password"] { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--panel-2); color: var(--text); }
    .remember { display: flex; align-items: center; gap: 8px; margin: 10px 0; color: var(--muted); }
    .auth-footer { margin-top: 14px; text-align: center; color: var(--muted); }
</style>
<div class="auth-shell">
    <h2>登入</h2>
    <p>使用您的帳號進入管理與購票。</p>
    <form action="" method="post" novalidate>
        {{ form.hidden_tag() }}
        <label for="username">用戶名</label>
        {{ form.username(size=32, class_="", placeholder="輸入用戶名") }}
        {% for error in form.username.errors %}<div style="color: var(--danger); font-size: 0.9rem;">{{ error }}</div>{% endfor %}

        <label for="password">密碼</label>
        {{ form.password(size=32, class_="", placeholder="輸入密碼") }}
        {% for error in form.password.errors %}<div style="color: var(--danger); font-size: 0.9rem;">{{ error }}</div>{% endfor %}

        <div class="remember">
            {{ form.remember_me() }} <label for="remember_me">記住我</label>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;">登入</button>
    </form>
    <div class="auth-footer">
        還沒有帳號？ <a href="{{ url_for('register') }}">註冊</a>
    </div>
</div>
{% endblock %}
