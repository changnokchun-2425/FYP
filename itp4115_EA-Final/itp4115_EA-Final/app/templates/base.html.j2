{# ========================================
   BASE TEMPLATE
   ========================================
   Purpose: Master template for all pages
   Features:
   - Common header with cinema branding
   - Navigation bar (dynamic based on user auth)
   - Flash message display
   - Common footer
   - Bootstrap integration
   
   Usage: {% extends "base.html.j2" %}
          {% block content %}...{% endblock %}
======================================== #}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- ========== META TAGS ========== -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- ========== EXTERNAL STYLESHEETS ========== -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    
    <title>{% block title %}Pegasus Shop{% endblock %}</title>
    
    <!-- ========== CUSTOM STYLES ========== -->
    <style>
        body {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
            min-height: 100vh;
            color: #fff;
        }
        .cinema-header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            padding: 2rem;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        .cinema-header h1 {
            font-size: 3rem;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            color: #fff;
        }
        .cinema-header p {
            font-size: 1.2rem;
            opacity: 0.9;
            color: #fff;
        }
        .cinema-nav {
            background-color: #1a1a1a;
            padding: 1rem;
            text-align: center;
            border-bottom: 2px solid #2a5298;
        }
        .cinema-nav a {
            color: #ffffff;
            text-decoration: none;
            margin: 0 1.5rem;
            font-size: 1.1rem;
            transition: color 0.3s;
        }
        .cinema-nav a:hover,
        .cinema-nav a.active {
            color: #e50914;
        }
        .footer {
            background-color: #0a0a0a;
            text-align: center;
            padding: 2rem;
            margin-top: 3rem;
            border-top: 2px solid #2a5298;
        }
        .footer div {
            color: #888;
        }
        @media (max-width: 768px) {
            .cinema-nav a {
                display: inline-block;
                margin: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- ========================================
         SITE HEADER
    ======================================== -->
    <header class="cinema-header">
        <h1>🎬 FYP Cinema</h1>
        <p>香港首選電影院線 - 極致觀影體驗</p>
    </header>

    <nav class="cinema-nav">
        <a href="{{ url_for('cinema_index') }}">🎬 現正熱映</a>
        <a href="{{ url_for('cinema_coming_soon') }}">📅 即將上映</a>
        {% if current_user.is_authenticated %}
        <a href="{{ url_for('profile') }}">👤 個人中心</a>
        <a href="{{ url_for('logout') }}">🚪 登出</a>
        {% else %}
        <a href="{{ url_for('login') }}">🔑 登入</a>
        <a href="{{ url_for('register') }}">✨ 註冊</a>
        {% endif %}
    </nav>
    </nav>
    
    <div style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div style="max-width: 1400px; margin: 0 auto; padding: 1rem 2rem 0;">
                    {% for category, message in messages %}
                    <div class="alert alert-{% if category == 'error' %}danger{% elif category == 'success' %}success{% else %}info{% endif %} alert-dismissible fade show" role="alert">
                        {% if category == 'success' %}✅{% elif category == 'error' %}❌{% else %}ℹ️{% endif %}
                        {{ message }}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}
        {% block content %}{% endblock %}
    </div>
    <footer class="footer">
        <div>
            &copy; 2025 FYP Cinema. All rights reserved. | 香港首選電影院線
            <br>
            客戶服務熱線: 2317 6666
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    
</body>
</html>