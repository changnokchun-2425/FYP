{% extends "base.html.j2" %}

{% block title %}VIP購買成功{% endblock %}

{% block content %}
<style>
    .success-container {
        max-width: 800px;
        margin: 60px auto;
        padding: 40px;
    }
    
    .success-card {
        background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
        border-radius: 20px;
        padding: 50px;
        text-align: center;
        color: white;
        box-shadow: 0 10px 30px rgba(46, 204, 113, 0.3);
        margin-bottom: 30px;
    }
    
    .success-icon {
        font-size: 80px;
        margin-bottom: 20px;
        animation: scaleIn 0.5s ease-out;
    }
    
    @keyframes scaleIn {
        0% {
            transform: scale(0);
        }
        50% {
            transform: scale(1.2);
        }
        100% {
            transform: scale(1);
        }
    }
    
    .success-title {
        font-size: 36px;
        font-weight: bold;
        margin-bottom: 15px;
    }
    
    .success-subtitle {
        font-size: 18px;
        opacity: 0.95;
        margin-bottom: 30px;
    }
    
    .vip-details-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        margin-bottom: 30px;
    }
    
    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0;
        border-bottom: 2px solid #f0f0f0;
    }
    
    .detail-row:last-child {
        border-bottom: none;
    }
    
    .detail-label {
        font-size: 18px;
        color: #7f8c8d;
        font-weight: 500;
    }
    
    .detail-value {
        font-size: 20px;
        color: #2c3e50;
        font-weight: bold;
    }
    
    .detail-value.highlight {
        color: #e74c3c;
        font-size: 24px;
    }
    
    .detail-value.vip-badge {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        color: white;
        padding: 8px 20px;
        border-radius: 25px;
        font-size: 18px;
    }
    
    .benefits-section {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        border-radius: 15px;
        padding: 30px;
        color: white;
        margin-bottom: 30px;
    }
    
    .benefits-title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
        text-align: center;
    }
    
    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
    
    .benefit-item {
        background: rgba(255, 255, 255, 0.1);
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        backdrop-filter: blur(10px);
    }
    
    .benefit-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }
    
    .benefit-text {
        font-size: 16px;
        line-height: 1.5;
    }
    
    .auto-renew-notice {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 30px;
    }
    
    .auto-renew-notice.disabled {
        background: #f8f9fa;
        border-left: 4px solid #6c757d;
    }
    
    .notice-title {
        font-size: 18px;
        font-weight: bold;
        color: #856404;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .notice-title.disabled {
        color: #495057;
    }
    
    .notice-text {
        color: #856404;
        font-size: 15px;
        line-height: 1.6;
    }
    
    .notice-text.disabled {
        color: #6c757d;
    }
    
    .action-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 30px;
    }
    
    .btn-action {
        padding: 15px 40px;
        font-size: 18px;
        font-weight: bold;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }
    
    .btn-primary-action {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
    }
    
    .btn-primary-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(231, 76, 60, 0.4);
    }
    
    .btn-secondary-action {
        background: white;
        color: #e74c3c;
        border: 2px solid #e74c3c;
    }
    
    .btn-secondary-action:hover {
        background: #e74c3c;
        color: white;
        transform: translateY(-2px);
    }
    
    .countdown-text {
        text-align: center;
        color: #7f8c8d;
        font-size: 14px;
        margin-top: 20px;
    }
</style>

<div class="success-container">
    <!-- Success Header -->
    <div class="success-card">
        <div class="success-icon">🎉</div>
        <div class="success-title">恭喜您成為VIP會員！</div>
        <div class="success-subtitle">感謝您的支持，專屬優惠已為您開啟</div>
    </div>
    
    <!-- VIP Details -->
    <div class="vip-details-card">
        <div class="detail-row">
            <span class="detail-label">👑 會籍類型</span>
            <span class="detail-value vip-badge">{{ vip_info.vip_type_name }}</span>
        </div>
        
        <div class="detail-row">
            <span class="detail-label">💰 付款金額</span>
            <span class="detail-value highlight">HK$ {{ vip_info.price }}</span>
        </div>
        
        <div class="detail-row">
            <span class="detail-label">📅 生效日期</span>
            <span class="detail-value">{{ vip_info.expiry_date.strftime('%Y年%m月%d日') if vip_info.expiry_date else 'N/A' }}</span>
        </div>
        
        <div class="detail-row">
            <span class="detail-label">⏰ 到期日期</span>
            <span class="detail-value highlight">{{ vip_info.expiry_date.strftime('%Y年%m月%d日') if vip_info.expiry_date else 'N/A' }}</span>
        </div>
        
        <div class="detail-row">
            <span class="detail-label">🔄 自動續費</span>
            <span class="detail-value" style="color: {{ '#27ae60' if vip_info.auto_renew else '#e74c3c' }}">
                {{ '已開啟 ✓' if vip_info.auto_renew else '未開啟 ✗' }}
            </span>
        </div>
    </div>
    
    <!-- Auto-Renew Notice -->
    {% if vip_info.auto_renew %}
    <div class="auto-renew-notice">
        <div class="notice-title">
            <span>🔄</span>
            <span>自動續費已開啟</span>
        </div>
        <div class="notice-text">
            系統將在到期日 <strong>{{ vip_info.expiry_date.strftime('%Y年%m月%d日') }}</strong> 自動為您續費。
            <br>
            續費金額：<strong>HK$ {{ vip_info.price }}</strong>
            <br>
            您可以隨時在個人資料頁面關閉自動續費功能。
            <br><br>
            <strong>⚠️ 重要提醒：</strong>請確保您的付款方式有效，以免影響自動續費。
        </div>
    </div>
    {% else %}
    <div class="auto-renew-notice disabled">
        <div class="notice-title disabled">
            <span>ℹ️</span>
            <span>自動續費未開啟</span>
        </div>
        <div class="notice-text disabled">
            您的VIP會籍將於 <strong>{{ vip_info.expiry_date.strftime('%Y年%m月%d日') }}</strong> 到期。
            <br>
            到期後，您需要手動續費以繼續享受VIP專屬優惠。
            <br>
            您可以隨時在個人資料頁面開啟自動續費功能。
        </div>
    </div>
    {% endif %}
    
    <!-- VIP Benefits -->
    <div class="benefits-section">
        <div class="benefits-title">🎁 您的專屬VIP特權</div>
        
        <div class="benefits-grid">
            <div class="benefit-item">
                <div class="benefit-icon">⚡</div>
                <div class="benefit-text">
                    <strong>+50% 積分加成</strong><br>
                    每次消費獲得額外50%積分
                </div>
            </div>
            
            <div class="benefit-item">
                <div class="benefit-icon">🎟️</div>
                <div class="benefit-text">
                    <strong>優先訂票</strong><br>
                    搶先預訂熱門電影場次
                </div>
            </div>
            
            <div class="benefit-item">
                <div class="benefit-icon">🎁</div>
                <div class="benefit-text">
                    <strong>專屬優惠券</strong><br>
                    定期獲得VIP專屬折扣券
                </div>
            </div>
            
            <div class="benefit-item">
                <div class="benefit-icon">👑</div>
                <div class="benefit-text">
                    <strong>會員等級提升</strong><br>
                    更快升級到更高會員等級
                </div>
            </div>
        </div>
    </div>
    
    <!-- Action Buttons -->
    <div class="action-buttons">
        <a href="{{ url_for('cinema_index') }}" class="btn-action btn-primary-action">
            🎬 立即訂票享受優惠
        </a>
        <a href="{{ url_for('profile') }}" class="btn-action btn-secondary-action">
            👤 查看我的會員資料
        </a>
    </div>
</div>

{% endblock %}
