{% extends "base.html.j2" %}

{% block content %}
<h1>Sales</h1>
<body>
    {% for item in sales_items %}
        <li>
            <strong>{{ item.item }}</strong>: {{ item.price }} - {{ item.description }}
        </li>
    {% endfor %}
</body>
<p>
    <a href="{{ url_for('index') }}">Back to Home</a>
</p>
{% endblock %}