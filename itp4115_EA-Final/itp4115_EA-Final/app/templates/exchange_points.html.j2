{# ========================================
   POINTS EXCHANGE PAGE
   ========================================
   Purpose: Allow users to exchange points for coupons
   Features:
   - Display available coupons for exchange
   - Show user's current points
   - Exchange functionality
======================================== #}

<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>積分兌換 - FYP Cinema</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Microsoft YaHei', 'Arial', sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
            min-height: 100vh;
            color: #fff;
        }

        header {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        header h1 {
            color: #fff;
            font-size: 2rem;
            text-align: center;
        }

        nav {
            background-color: #1a1a1a;
            padding: 1rem;
            text-align: center;
            border-bottom: 2px solid #f39c12;
        }

        nav a {
            color: #fff;
            text-decoration: none;
            margin: 0 1rem;
            padding: 0.5rem 1rem;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        nav a:hover {
            background-color: #f39c12;
        }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .points-banner {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            padding: 2rem;
            border-radius: 15px;
            text-align: center;
            margin-bottom: 2rem;
            box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
        }

        .points-banner h2 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        .points-banner p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .exchange-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .coupon-card {
            background: linear-gradient(145deg, #2a2a2a 0%, #1a1a1a 100%);
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: transform 0.3s, box-shadow 0.3s;
            border: 2px solid #f39c12;
        }

        .coupon-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(243, 156, 18, 0.4);
        }

        .coupon-card.disabled {
            opacity: 0.5;
            border-color: #666;
        }

        .coupon-card.disabled:hover {
            transform: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        .coupon-header {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f39c12;
        }

        .coupon-icon {
            font-size: 3rem;
            margin-right: 1rem;
        }

        .coupon-title h3 {
            font-size: 1.5rem;
            color: #f39c12;
            margin-bottom: 0.3rem;
        }

        .coupon-discount {
            font-size: 1.2rem;
            font-weight: bold;
            color: #fff;
        }

        .coupon-details {
            margin: 1rem 0;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            font-size: 0.95rem;
        }

        .detail-label {
            color: #aaa;
        }

        .detail-value {
            color: #fff;
            font-weight: bold;
        }

        .points-cost {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            padding: 1rem;
            border-radius: 10px;
            text-align: center;
            margin: 1rem 0;
        }

        .points-cost-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 0.3rem;
        }

        .points-cost-value {
            font-size: 1.8rem;
            font-weight: bold;
        }

        .exchange-btn {
            width: 100%;
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: bold;
            color: #fff;
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
        }

        .exchange-btn:hover:not(:disabled) {
            background: linear-gradient(135deg, #229954 0%, #1e8449 100%);
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.4);
        }

        .exchange-btn:disabled {
            background: #555;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .flash-messages {
            max-width: 1200px;
            margin: 1rem auto;
            padding: 0 1rem;
        }

        .alert {
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 1rem;
        }

        .alert-success {
            background-color: #27ae60;
            color: #fff;
        }

        .alert-error {
            background-color: #e74c3c;
            color: #fff;
        }

        .info-text {
            text-align: center;
            color: #aaa;
            margin-top: 2rem;
            padding: 1rem;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .info-text p {
            margin: 0.5rem 0;
        }
    </style>
</head>
<body>
    <header>
        <h1>🌟 積分兌換中心</h1>
    </header>

    <nav>
        <a href="{{ url_for('cinema_index') }}">🎬 首頁</a>
        <a href="{{ url_for('profile') }}">👤 會員中心</a>
        <a href="{{ url_for('my_coupons') }}">🎫 我的優惠券</a>
        <a href="{{ url_for('my_bookings') }}">📋 我的訂票</a>
        <a href="{{ url_for('logout') }}">🚪 登出</a>
    </nav>

    <!-- Flash Messages -->
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            <div class="flash-messages">
                {% for category, message in messages %}
                    <div class="alert alert-{{ category }}">
                        {{ message }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endwith %}

    <div class="container">
        <!-- Points Banner -->
        <div class="points-banner">
            <h2>💰 您的積分</h2>
            <p style="font-size: 3rem; font-weight: bold; margin: 1rem 0;">{{ user_points }}</p>
            <p>購買電影票可賺取積分：HK$1 = 5 積分</p>
        </div>

        <!-- Exchange Options -->
        <div class="exchange-grid">
            {% for option in exchange_options %}
            <div class="coupon-card {% if not option.can_afford %}disabled{% endif %}">
                <div class="coupon-header">
                    <div class="coupon-icon">{{ option.icon }}</div>
                    <div class="coupon-title">
                        <h3>{{ option.name }}</h3>
                        <div class="coupon-discount">{{ option.discount }}</div>
                    </div>
                </div>

                <div class="coupon-details">
                    <div class="detail-row">
                        <span class="detail-label">說明</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-value">{{ option.description }}</span>
                    </div>
                    {% if option.min_purchase > 0 %}
                    <div class="detail-row">
                        <span class="detail-label">最低消費</span>
                        <span class="detail-value">HK${{ option.min_purchase }}</span>
                    </div>
                    {% endif %}
                </div>

                <div class="points-cost">
                    <div class="points-cost-label">所需積分</div>
                    <div class="points-cost-value">{{ option.points_cost }} 點</div>
                </div>

                <form method="POST" action="{{ url_for('do_exchange_points', coupon_type=option.type) }}">
                    <button type="submit" class="exchange-btn" 
                            {% if not option.can_afford %}disabled{% endif %}>
                        {% if option.can_afford %}
                            立即兌換
                        {% else %}
                            積分不足
                        {% endif %}
                    </button>
                </form>
            </div>
            {% endfor %}
        </div>

        <div class="info-text">
            <p>💡 購買電影票可賺取積分，HK$1 = 5 積分</p>
            <p>🎁 積分可兌換各種優惠券，立即開始累積吧！</p>
            <p>⏰ 兌換的優惠券有效期為 30 天</p>
        </div>
    </div>
</body>
</html>
