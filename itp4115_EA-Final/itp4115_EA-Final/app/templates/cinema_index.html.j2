{% extends "base.html.j2" %}
{% block title %}即日上映 - FYP Cinema{% endblock %}
{% block content %}
<style>
    .hero {
        margin-top: 18px;
        padding: 26px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(246,208,0,0.14), rgba(246,208,0,0.04));
        border: 1px solid var(--border);
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: center;
    }
    .hero-text h1 { margin: 0 0 6px 0; font-size: 1.6rem; letter-spacing: 0.3px; }
    .hero-text p { margin: 0; color: var(--muted); }
    .hero-actions { display: flex; gap: 10px; }
    .movie-card-hk {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: var(--card-radius);
        background: var(--panel);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }
    .movie-poster {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        background: #0e0e0e;
        border-bottom: 1px solid var(--border);
    }
    .movie-body { padding: 14px; display: flex; flex-direction: column; gap: 8px; }
    .movie-title { margin: 0; font-size: 1rem; font-weight: 800; }
    .movie-meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 0.85rem; color: var(--muted); }
    .badge { padding: 4px 8px; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--border); }
    .movie-actions { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .movie-desc { color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
    .section-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .section-header .pill { background: rgba(246,208,0,0.12); color: var(--primary); }
</style>

<section class="hero">
    <div class="hero-text">
        <h1>即日上映 • 精選場次</h1>
        <p>黑金配色 + 黃色點綴，重現 HKMovie6 的戲院氛圍。</p>
    </div>
    <div class="hero-actions">
        <a class="btn btn-primary" href="{{ url_for('cinema_coming_soon') }}">查看即將上映</a>
        <a class="btn btn-ghost" href="{{ url_for('index') }}">回到主頁</a>
    </div>
</section>

<section class="section">
    <div class="section-header">
        <h2>即日上映</h2>
        <span class="pill">{{ movies|length }} 套電影</span>
    </div>
    <div class="grid-cards">
        {% for movie in movies %}
        <article class="movie-card-hk">
            <img class="movie-poster" src="{{ movie.poster }}" alt="{{ movie.title }}" onerror="this.src='https://via.placeholder.com/300x450?text=FYP+Cinema'">
            <div class="movie-body">
                <h3 class="movie-title">{{ movie.title }}</h3>
                <div class="movie-meta">
                    <span class="badge">{{ movie.rating or 'IIB' }}</span>
                    <span class="badge">{{ movie.duration }}</span>
                    {% if movie.genre %}<span class="badge">{{ movie.genre }}</span>{% endif %}
                </div>
                <p class="movie-desc">{{ movie.description or '精彩內容敬請期待。' }}</p>
                <div class="movie-actions">
                    <a class="btn btn-primary" href="{{ url_for('cinema_movie', movie_id=movie.id) }}">購票</a>
                    <span class="pill">🎟️ 熱賣中</span>
                </div>
            </div>
        </article>
        {% else %}
            <div class="card" style="padding:16px;">暫無電影資料。</div>
        {% endfor %}
    </div>
</section>
{% endblock %}
