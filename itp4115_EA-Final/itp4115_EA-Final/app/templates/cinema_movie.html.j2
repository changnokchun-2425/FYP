{% extends "base.html.j2" %}
{% block title %}{{ movie.title }} - FYP Cinema{% endblock %}
{% block content %}
{% set fallback_poster = movie.poster or 'https://storage.movie6.com/movie/118ca_1_1770188030.jpg' %}
<style>
    .hero { position: relative; overflow: hidden; border-radius: 18px; border: 1px solid var(--border); background: #080808; margin-top: 16px; }
    .hero-bg { position: absolute; inset: 0; background: linear-gradient(120deg, rgba(0,0,0,0.7), rgba(0,0,0,0.4)), url('{{ fallback_poster }}') center/cover no-repeat; filter: blur(8px) brightness(0.6); transform: scale(1.1); }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.55) 50%, rgba(0,0,0,0.35) 100%); }
    .hero-content { position: relative; display: grid; grid-template-columns: 320px 1fr; gap: 24px; padding: 28px; align-items: center; }
    .poster-card { position: relative; }
    .poster-card img { width: 100%; border-radius: 18px; border: 1px solid var(--border); box-shadow: 0 12px 32px rgba(0,0,0,0.6); object-fit: cover; aspect-ratio: 2/3; background: #0c0c0c; }
    .poster-badges { position: absolute; bottom: 12px; left: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
    .pill-ghost { padding: 6px 12px; border-radius: 999px; background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.12); color: #f7f7f7; font-weight: 700; letter-spacing: 0.2px; }
    .hero-copy { display: flex; flex-direction: column; gap: 14px; color: #fafafa; }
    .eyebrow { color: #f6d000; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; font-size: 12px; }
    .hero-title { margin: 0; font-size: 34px; font-weight: 900; letter-spacing: 0.3px; }
    .hero-desc { margin: 0; color: #d6d6d6; line-height: 1.6; max-width: 720px; }
    .meta-line { display: flex; gap: 10px; flex-wrap: wrap; }
    .pill { padding: 8px 12px; border-radius: 12px; background: rgba(246,208,0,0.15); color: #f6d000; border: 1px solid rgba(246,208,0,0.35); font-weight: 800; }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
    .btn-ghost-strong { padding: 10px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.2); color: #fff; font-weight: 700; background: rgba(255,255,255,0.05); }
    .detail-shell { margin-top: 18px; display: grid; grid-template-columns: 1fr 420px; gap: 18px; }
    .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 16px; padding: 18px; box-shadow: var(--shadow); }
    .panel h3 { margin: 0 0 10px 0; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
    .info-card { padding: 12px; border-radius: 12px; background: var(--panel-2); border: 1px solid var(--border); color: var(--muted); }
    .info-label { color: var(--muted); font-size: 12px; letter-spacing: 0.3px; text-transform: uppercase; }
    .info-value { color: var(--text); font-weight: 800; font-size: 15px; }
    label { display: block; margin: 12px 0 6px 0; color: var(--text); font-weight: 700; }
    select, input[type="text"], input[type="email"] {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--panel-2);
        color: var(--text);
    }
    .showtime-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
    .showtime-pill { padding: 10px 12px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: var(--text); display: inline-flex; gap: 6px; align-items: center; }
    .seat-selection { margin-top: 14px; }
    .cinema-screen { text-align: center; padding: 10px; border: 1px dashed var(--border); border-radius: 10px; color: var(--muted); }
    .seat-map { margin-top: 12px; display: flex; flex-direction: column; gap: 6px; }
    .seat-row { display: grid; grid-template-columns: 28px repeat(10, 1fr); gap: 6px; align-items: center; }
    .seat-row-label { text-align: center; color: var(--muted); font-weight: 700; }
    .seat { padding: 8px 0; border-radius: 8px; background: var(--panel-2); border: 1px solid var(--border); text-align: center; cursor: pointer; }
    .seat.selected { background: var(--primary); color: #0b0b0b; font-weight: 800; }
    .seat.occupied { background: #2a2a2a; color: #777; cursor: not-allowed; }
    .seat-legend { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 10px; color: var(--muted); }
    .legend-item { display: flex; gap: 6px; align-items: center; }
    .legend-box { width: 16px; height: 16px; border-radius: 4px; border: 1px solid var(--border); }
    .legend-available { background: var(--panel-2); }
    .legend-selected { background: var(--primary); border-color: var(--primary); }
    .legend-occupied { background: #2a2a2a; }
    .selected-seats-display { margin-top: 10px; padding: 10px; border-radius: 10px; background: var(--panel-2); color: var(--text); }
    .price-info { margin-top: 12px; padding: 12px; border-radius: 12px; background: rgba(246,208,0,0.06); border: 1px solid var(--border); }
    .coupon-section { margin-top: 12px; padding: 12px; border-radius: 12px; background: rgba(246,208,0,0.08); border: 1px dashed var(--primary); }
    .coupon-info { display: none; margin-top: 8px; padding: 10px; border-radius: 10px; background: var(--panel-2); border: 1px solid var(--border); }
    .coupon-info.active { display: block; }
    .action-row { display: flex; gap: 10px; margin-top: 14px; }
    .note-box { margin-top: 10px; padding: 12px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px dashed var(--border); color: var(--muted); }
    @media (max-width: 1080px) { .hero-content { grid-template-columns: 260px 1fr; } }
    @media (max-width: 820px) {
        .hero-content { grid-template-columns: 1fr; }
        .poster-card { max-width: 280px; }
        .detail-shell { grid-template-columns: 1fr; }
    }
</style>

<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="poster-card">
            <img src="{{ fallback_poster }}" alt="{{ movie.title }}" onerror="this.src='https://via.placeholder.com/400x600?text=FYP+Cinema'">
            <div class="poster-badges">
                <span class="pill-ghost">{{ movie.rating or 'IIB' }}</span>
                <span class="pill-ghost">{{ movie.duration }}</span>
                {% if movie.genre %}<span class="pill-ghost">{{ movie.genre }}</span>{% endif %}
                {% if movie.release_date %}<span class="pill-ghost">上映 {{ movie.release_date }}</span>{% endif %}
            </div>
        </div>
        <div class="hero-copy">
            <div class="eyebrow">m6 screening 61 • 特別場</div>
            <h1 class="hero-title">{{ movie.title }}</h1>
            <p class="hero-desc">{{ movie.description }}</p>
            <div class="meta-line">
                <span class="pill">HK${{ movie.price }} / 張</span>
                <span class="pill">🎟️ 映後謝票場</span>
                <span class="pill">🎁 限定收藏卡</span>
            </div>
            <div class="hero-actions">
                <a class="btn btn-primary" href="#booking">立即購票</a>
                <span class="btn-ghost-strong">安全交易 • 即時確認</span>
            </div>
        </div>
    </div>
</section>

<section class="detail-shell">
    <div class="panel">
        <h3>放映資訊</h3>
        <div class="info-grid">
            <div class="info-card"><div class="info-label">上映日期</div><div class="info-value">{{ movie.release_date or '待公布' }}</div></div>
            <div class="info-card"><div class="info-label">片長</div><div class="info-value">{{ movie.duration }}</div></div>
            <div class="info-card"><div class="info-label">級別</div><div class="info-value">{{ movie.rating or 'IIB' }}</div></div>
            <div class="info-card"><div class="info-label">票價</div><div class="info-value">HK${{ movie.price }}</div></div>
        </div>
        <div style="margin-top:14px; color: var(--text); line-height:1.6;">{{ movie.description }}</div>

        <h4 style="margin-top:18px; margin-bottom:8px;">場次</h4>
        <div class="showtime-pills">
            {% for st in movie.showtimes %}
                <span class="showtime-pill">🕒 {{ st.label }} <span style="color:#f6d000; font-weight:800;">HK${{ st.price }}</span></span>
            {% endfor %}
        </div>

        <div class="note-box">到場換領實體票及收藏卡，請提前 15 分鐘到場。</div>
    </div>

    <div class="panel" id="booking">
        <h3>購票</h3>
        {% if current_user.is_authenticated %}
        <form method="post" action="{{ url_for('cinema_buy_ticket') }}" id="bookingForm">
            <input type="hidden" name="movie_id" value="{{ movie.id }}">

            <label for="showtime">選擇場次</label>
            <select name="showtime" id="showtime" required onchange="loadSeats()">
                <option value="">請選擇場次</option>
                {% for st in movie.showtimes %}
                <option value="{{ st.id }}">{{ st.label }}</option>
                {% endfor %}
            </select>

            <div class="seat-selection" id="seatSelection" style="display:none;">
                <div class="cinema-screen">SCREEN</div>
                <div class="seat-map" id="seatMap"></div>
                <div class="seat-legend">
                    <div class="legend-item"><div class="legend-box legend-available"></div><span>可選</span></div>
                    <div class="legend-item"><div class="legend-box legend-selected"></div><span>已選</span></div>
                    <div class="legend-item"><div class="legend-box legend-occupied"></div><span>已售</span></div>
                </div>
                <div class="selected-seats-display" id="selectedSeatsDisplay" style="display:none;">
                    <p><strong>已選：</strong><span id="selectedSeatsList"></span></p>
                    <p><strong>數量：</strong><span id="selectedSeatsCount">0</span> 張</p>
                </div>
                <input type="hidden" name="selected_seats" id="selected_seats" value="">
            </div>

            <label for="name">姓名</label>
            <input type="text" name="name" id="name" value="{{ current_user.username }}" required>

            <label for="email">電郵</label>
            <input type="email" name="email" id="email" value="{{ current_user.email }}" required>

            <input type="hidden" name="seats" id="seats" value="1">

            <div class="coupon-section">
                <h4 style="margin:0 0 8px 0;">優惠券 (可選)</h4>
                <label for="coupon_code">選擇優惠券</label>
                <select name="coupon_code" id="coupon_code" onchange="applyCoupon()">
                    <option value="">不使用</option>
                    <option value="manual">手動輸入</option>
                    <optgroup label="我的優惠券" id="userCouponsGroup"></optgroup>
                </select>
                <div id="manualCouponInput" style="display:none; margin-top:8px;">
                    <input type="text" id="manual_coupon_code" placeholder="輸入優惠券" style="text-transform: uppercase;">
                    <div class="action-row">
                        <button type="button" class="btn btn-primary" onclick="validateManualCoupon()">驗證</button>
                    </div>
                </div>
                <div id="couponInfo" class="coupon-info">
                    <p id="couponName">📌 優惠券：<span></span></p>
                    <p id="couponDiscount">💰 折扣：<span></span></p>
                    <p id="couponExpiry">📅 到期：<span></span></p>
                </div>
            </div>

            <div class="price-info">
                <p><strong>票價：</strong>HK$<span id="pricePerSeat">{{ movie.price }}</span> / 張</p>
                <p id="originalPrice" style="display:none;"><strong>原價：</strong>HK$<span>{{ movie.price }}</span></p>
                <p id="discountAmount" style="display:none;"><strong>優惠：</strong>-HK$<span>0</span></p>
                <p id="totalPrice"><strong>總計：</strong>HK$<span>{{ movie.price }}</span></p>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; margin-top:12px;">🎫 確認購票</button>
        </form>
        {% else %}
        <div style="text-align:center; padding:16px; background: var(--panel-2); border-radius: 12px; border:1px solid var(--border);">
            <p style="margin:0 0 12px 0;">請先登入以購票</p>
            <a class="btn btn-primary" href="{{ url_for('login', next=request.path) }}">前往登入</a>
        </div>
        {% endif %}
    </div>
</section>

<script>
    // Coupon and seat selection logic (ported from previous template)
    let availableCoupons = [];
    let currentDiscount = 0;
    let currentCouponCode = '';
    let selectedSeats = [];
    const ROWS = ['A','B','C','D','E','F','G','H'];
    const SEATS_PER_ROW = 10;
    const initialSoldSeatsByShowtime = {{ sold_seats_by_showtime|tojson }};
    let occupiedSeats = [];

    document.addEventListener('DOMContentLoaded', async function() {
        await loadUserCoupons();
        updatePrice();
    });

    async function fetchSoldSeats(showtimeId) {
        try {
            const response = await fetch(`/api/showtime/${showtimeId}/sold_seats`);
            if (!response.ok) return initialSoldSeatsByShowtime[String(showtimeId)] || [];
            const data = await response.json();
            if (data.success && Array.isArray(data.sold_seats)) {
                return data.sold_seats;
            }
        } catch (error) {
            console.error('Failed to load sold seats:', error);
        }
        return initialSoldSeatsByShowtime[String(showtimeId)] || [];
    }

    async function loadSeats() {
        const showtime = document.getElementById('showtime').value;
        const seatSelection = document.getElementById('seatSelection');
        const seatMap = document.getElementById('seatMap');
        if (!showtime) { seatSelection.style.display = 'none'; return; }
        occupiedSeats = await fetchSoldSeats(showtime);
        selectedSeats = [];
        updateSelectedSeatsDisplay();
        seatSelection.style.display = 'block';
        seatMap.innerHTML = '';
        ROWS.forEach(row => {
            const rowDiv = document.createElement('div');
            rowDiv.className = 'seat-row';
            const label = document.createElement('div');
            label.className = 'seat-row-label';
            label.textContent = row;
            rowDiv.appendChild(label);
            for (let i = 1; i <= SEATS_PER_ROW; i++) {
                const seatId = `${row}${i}`;
                const seat = document.createElement('div');
                seat.className = 'seat';
                seat.dataset.seatId = seatId;
                seat.textContent = i;
                if (occupiedSeats.includes(seatId)) {
                    seat.classList.add('occupied');
                    seat.textContent = '已售';
                } else {
                    seat.onclick = () => toggleSeat(seatId);
                }
                rowDiv.appendChild(seat);
            }
            seatMap.appendChild(rowDiv);
        });
    }

    function toggleSeat(seatId) {
        const seatElement = document.querySelector(`[data-seat-id="${seatId}"]`);
        if (selectedSeats.includes(seatId)) {
            selectedSeats = selectedSeats.filter(s => s !== seatId);
            seatElement.classList.remove('selected');
        } else {
            if (selectedSeats.length >= 10) { alert('最多只能選擇10個座位'); return; }
            selectedSeats.push(seatId);
            seatElement.classList.add('selected');
        }
        updateSelectedSeatsDisplay();
    }

    function updateSelectedSeatsDisplay() {
        const display = document.getElementById('selectedSeatsDisplay');
        const list = document.getElementById('selectedSeatsList');
        const count = document.getElementById('selectedSeatsCount');
        const seatsInput = document.getElementById('seats');
        const selectedSeatsInput = document.getElementById('selected_seats');
        if (selectedSeats.length > 0) {
            display.style.display = 'block';
            list.textContent = selectedSeats.sort().join(', ');
            count.textContent = selectedSeats.length;
            seatsInput.value = selectedSeats.length;
            selectedSeatsInput.value = selectedSeats.join(',');
        } else {
            display.style.display = 'none';
            seatsInput.value = 1;
            selectedSeatsInput.value = '';
        }
        updatePrice();
    }

    async function loadUserCoupons() {
        try {
            const response = await fetch('/api/get_user_coupons');
            if (!response.ok) return;
            const data = await response.json();
            if (data.success && data.coupons && data.coupons.length > 0) {
                availableCoupons = data.coupons;
                const optgroup = document.getElementById('userCouponsGroup');
                optgroup.innerHTML = '';
                data.coupons.forEach(coupon => {
                    const option = document.createElement('option');
                    option.value = coupon.code;
                    option.textContent = `${coupon.icon} ${coupon.name} - ${formatDiscount(coupon)}`;
                    option.dataset.coupon = JSON.stringify(coupon);
                    optgroup.appendChild(option);
                });
            }
        } catch (e) { console.error(e); }
    }

    function formatDiscount(coupon) {
        if (coupon.discount_type === 'percentage') return `${coupon.discount_value}% OFF`;
        return `HK$${coupon.discount_value} OFF`;
    }

    function applyCoupon() {
        const select = document.getElementById('coupon_code');
        const selectedValue = select.value;
        const manualInput = document.getElementById('manualCouponInput');
        const couponInfo = document.getElementById('couponInfo');
        manualInput.style.display = 'none';
        couponInfo.classList.remove('active');
        currentDiscount = 0;
        currentCouponCode = '';
        if (selectedValue === 'manual') {
            manualInput.style.display = 'block';
        } else if (selectedValue) {
            const selectedOption = select.options[select.selectedIndex];
            if (selectedOption.dataset.coupon) {
                const couponData = JSON.parse(selectedOption.dataset.coupon);
                displayCouponInfo(couponData);
                validateAndApplyDiscount(selectedValue);
            }
        }
        updatePrice();
    }

    async function validateManualCoupon() {
        const manualCode = document.getElementById('manual_coupon_code').value.trim().toUpperCase();
        if (!manualCode) { alert('請輸入優惠券代碼'); return; }
        await validateAndApplyDiscount(manualCode);
    }

    async function validateAndApplyDiscount(couponCode) {
        const seats = parseInt(document.getElementById('seats').value) || 1;
        const orderTotal = seats * {{ movie.price }};
        try {
            const response = await fetch('/api/validate_coupon', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ coupon_code: couponCode, order_total: orderTotal })
            });
            const result = await response.json();
            if (result.valid) {
                currentDiscount = result.discount;
                currentCouponCode = couponCode;
                document.getElementById('coupon_code').value = couponCode;
                if (result.coupon_name) {
                    displayCouponInfo({ name: result.coupon_name, description: result.coupon_description, discount_value: result.discount });
                }
            } else {
                alert(`❌ ${result.message}`);
                currentDiscount = 0;
                currentCouponCode = '';
            }
            updatePrice();
        } catch (error) {
            console.error('Validation error:', error);
            alert('❌ 優惠券驗證失敗，請稍後再試');
        }
    }

    function displayCouponInfo(coupon) {
        const couponInfo = document.getElementById('couponInfo');
        document.querySelector('#couponName span').textContent = coupon.name || '優惠券';
        document.querySelector('#couponDiscount span').textContent = coupon.description || formatDiscount(coupon);
        if (coupon.expiry_date) {
            document.querySelector('#couponExpiry span').textContent = coupon.expiry_date;
            document.getElementById('couponExpiry').style.display = 'block';
        } else {
            document.getElementById('couponExpiry').style.display = 'none';
        }
        couponInfo.classList.add('active');
    }

    function updatePrice() {
        const seats = parseInt(document.getElementById('seats').value) || 1;
        const pricePerSeat = {{ movie.price }};
        const subtotal = seats * pricePerSeat;
        const discount = Math.min(currentDiscount, subtotal);
        const total = subtotal - discount;
        if (discount > 0) {
            document.getElementById('originalPrice').style.display = 'block';
            document.getElementById('discountAmount').style.display = 'block';
            document.querySelector('#originalPrice span').textContent = subtotal.toFixed(2);
            document.querySelector('#discountAmount span').textContent = discount.toFixed(2);
        } else {
            document.getElementById('originalPrice').style.display = 'none';
            document.getElementById('discountAmount').style.display = 'none';
        }
        document.querySelector('#totalPrice span').textContent = total.toFixed(2);
    }

    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('bookingForm');
        if (form) {
            form.addEventListener('submit', function() {
                if (currentCouponCode) {
                    const couponInput = document.getElementById('coupon_code');
                    if (couponInput.value === 'manual') {
                        couponInput.value = document.getElementById('manual_coupon_code').value.trim().toUpperCase();
                    }
                }
            });
        }
    });
</script>
{% endblock %}
